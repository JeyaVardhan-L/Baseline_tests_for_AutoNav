---
import Layout from '../../layouts/Layout.astro';
import { readJson, runs } from '../../lib/data';
const prof = readJson<Record<string, string>>('profiles.json', {})!;
const cmp = readJson<any[]>('comparisons.json', [])!;
const all = runs();
const armRuns = all.filter((r) => r.profile === 'arm-cloud');
const piRuns = all.filter((r) => r.profile === 'pi5');
---
<Layout title="Hardware" description="What each hardware tier can and cannot establish.">
  <section class="wrap section">
    <p class="caption">G · Hardware tiers and conclusions</p>
    <h2>What the measurements say about constrained hardware</h2>
    <div class="grid cols-3">
      <div class="card"><div class="caption">Tier A · measured</div><h3>Development laptop</h3>
        <p class="muted">Full machine, 4 cores, 1 core (CPU affinity and thread limits; no memory cap, no clock cap).</p>
        <p>{prof['laptop-4c']}</p></div>
      <div class="card"><div class="caption">Tier B · {armRuns.length ? 'measured' : 'pending first CI run'}</div><h3>ARM cloud VM</h3>
        <p>{prof['arm-cloud']}</p>
        <p class="muted">{armRuns.length ? 'See the metrics page.' : 'The workflow is written and validated locally but has not run: it needs a push.'}</p></div>
      <div class="card"><div class="caption">Tier C · {piRuns.length ? 'measured' : 'UNAVAILABLE'}</div><h3>Raspberry Pi 5</h3>
        <p>{piRuns.length ? 'See the metrics page.' : 'Not measured. Run the same CLI with --profile pi5 on a real Pi 5; the CPU model in run.json identifies the hardware.'}</p></div>
    </div>
    <h3 style="margin-top:32px">What can be inferred</h3>
    <div class="card">
      {cmp.length ? <ul style="padding-left:18px;margin:0">{cmp.flatMap((c) => c.statements.map((s: string) => <li><span class="caption">{c.dataset} · {c.variant}</span><br />{s}</li>))}</ul> : <p class="muted">Needs published runs on more than one profile.</p>}
    </div>
    <div class="grid cols-2" style="margin-top:16px">
      <div class="card alt"><h3>Established</h3><ul style="padding-left:18px;margin:0"><li>Latency, tail latency and deadline-violation rate of this implementation on this laptop, per profile.</li><li>That limiting cores changes (or does not change) the result.</li></ul></div>
      <div class="card alt"><h3>Not established</h3><ul style="padding-left:18px;margin:0"><li>Raspberry Pi 5 or any embedded performance. A miss on 4 laptop cores makes a Pi miss very likely; a pass says nothing about the Pi.</li><li>Memory-bandwidth, cache and thermal behaviour of embedded boards.</li><li>Hard real-time guarantees from Python.</li><li>Flight conditions: vibration, IMU fusion, wind.</li></ul></div>
    </div>
    <p class="muted" style="margin-top:16px">Jetson and GPU execution are out of scope: the pipeline is CPU-only. A GPU path would be a separate project.</p>
  </section>
</Layout>