# ============================================================
# IRoC-U Autonomous Navigation — .gitignore
# ============================================================

# ---- Datasets (NEVER commit raw sensor data) ----
datasets/raw/
datasets/downloaded/
datasets/**/*.bin
datasets/**/*.bag
datasets/**/*.pcd
datasets/**/*.ply
datasets/**/*.las
datasets/**/*.laz
datasets/**/*.zip
datasets/**/*.tar.gz
datasets/**/*.tar
datasets/**/*.7z

# ---- Experiment raw data ----
experiments/**/raw/
experiments/**/processed/*.bin
experiments/**/processed/*.npy

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
*.whl
.eggs/
*.so

# ---- Virtual environments ----
venv/
.venv/
env/
.env/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- IDE / Editor ----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
.classpath

# ---- OS ----
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.DS_Store?
._*

# ---- Large outputs (keep figures, exclude heavy data) ----
*.pickle
*.pkl

# ---- Logs (keep structure, exclude large log files) ----
logs/*.log
logs/**/*.log

# ---- Temporary ----
tmp/
temp/
scratch/
