# ============================================================
# AutoNav Research Baseline — .gitignore
# ============================================================

# ---- Datasets (NEVER commit raw or downloaded sensor data) ----
datasets/**/raw/
datasets/**/downloaded/
datasets/**/*.bag
datasets/**/*.bin
datasets/**/*.pcd
datasets/**/*.ply
datasets/**/*.mcap
datasets/**/*.db3
datasets/**/*.zip
datasets/**/*.tar.gz
datasets/**/*.tar
datasets/**/*.7z
datasets/**/*.clf

# ---- Output Results (Keep directory structure, avoid committing machine runs) ----
results/*
!results/README.md
!results/.gitkeep

# ---- Python & Bytecode ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
*.whl
.eggs/
*.so
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/

# ---- Virtual environments ----
venv/
.venv/
env/
.env/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- IDE / Editor ----
.vscode/
.idea/
*.swp
*.swo
*~
*.bak

# ---- OS Artifacts ----
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# ---- Temporary & Scratch ----
tmp/
temp/
scratch/
nothing

# ---- Local-only config and data (never commit; holds the private Drive link) ----
config.local.yaml
datasets/newer-college/01_short_experiment/
datasets/oxford-spires/*/
artifacts/runs/
artifacts/local/
.venv-lab/
site/node_modules/
site/dist/
site/.astro/
